{
  "version": 2,
  "outputDirectory": "Public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/Login" },
    { "source": "/students", "destination": "/students/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/RASD", "destination": "/RASD/rasd-index.html" },
    { "source": "/HRA", "destination": "/HRA/hra-index.html" },
    { "source": "/RA", "destination": "/RA/ra-index.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/admin/index.html", "destination": "/admin", "permanent": true },
    { "source": "/students/index.html", "destination": "/students", "permanent": true },
    { "source": "/RASD/rasd-index.html", "destination": "/RASD", "permanent": true },
    { "source": "/HRA/hra-index.html", "destination": "/HRA", "permanent": true },
    { "source": "/RA/ra-index.html", "destination": "/RA", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}