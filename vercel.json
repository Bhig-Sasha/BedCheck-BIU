
{
  "version": 2,
  "outputDirectory": "Public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/Login"
    },
    {
      "source": "/students",
      "destination": "/students/index.html"
    },
    {
      "source": "/students/",
      "destination": "/students/index.html"
    },
    {
      "source": "/students/(.*)",
      "destination": "/students/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/Student",
      "destination": "/admin/Student"
    },
    {
      "source": "/RASD",
      "destination": "/RASD/rasd-index.html"
    },
    {
      "source": "/RASD/",
      "destination": "/RASD/rasd-index.html"
    },
    {
      "source": "/RASD/(.*)",
      "destination": "/RASD/$1"
    },
    {
      "source": "/HRA",
      "destination": "/HRA/hra-index.html"
    },
    {
      "source": "/HRA/",
      "destination": "/HRA/hra-index.html"
    },
    {
      "source": "/HRA/(.*)",
      "destination": "/HRA/$1"
    },
    {
      "source": "/RA",
      "destination": "/RA/ra-index.html"
    },
    {
      "source": "/RA/",
      "destination": "/RA/ra-index.html"
    },
    {
      "source": "/RA/(.*)",
      "destination": "/RA/$1"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/students/index.html",
      "destination": "/students",
      "permanent": true
    },
    {
      "source": "/admin/index.html",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/RASD/rasd-index.html",
      "destination": "/RASD/",
      "permanent": true
    },
    {
      "source": "/HRA/hra-index.html",
      "destination": "/HRA/",
      "permanent": true
    },
    {
      "source": "/RA/ra-index.html",
      "destination": "/RA/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
