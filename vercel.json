
{
  "version": 2,
  "outputDirectory": "Public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/Login"
    },
    {
      "source": "/students",
      "destination": "/students/index"
    },
    {
      "source": "/Student",
      "destination": "/admin/Student"
    },
    {
      "source": "/admin",
      "destination": "/admin/index"
    },
    {
      "source": "/admin/Audit",
      "destination": "/admin/Audit"
    },
    {
      "source": "/admin/Hostels",
      "destination": "/admin/Hostels"
    },
    {
      "source": "/admin/Profile",
      "destination": "/admin/Profile"
    },
    {
      "source": "/admin/Report",
      "destination": "/admin/Report"
    },
    {
      "source": "/admin/Session",
      "destination": "/admin/Session"
    },
    {
      "source": "/admin/Staff",
      "destination": "/admin/Staff"
    },
    {
      "source": "/admin/Student",
      "destination": "/admin/Student"
    },
    {
      "source": "/RASD",
      "destination": "/RASD/rasd-index"
    },
    {
      "source": "/RASD/(.*)",
      "destination": "/RASD/$1"
    },
    {
      "source": "/HRA",
      "destination": "/HRA/hra-index"
    },
    {
      "source": "/HRA/(.*)",
      "destination": "/HRA/$1"
    },
    {
      "source": "/RA",
      "destination": "/RA/ra-index"
    },
    {
      "source": "/RA/(.*)",
      "destination": "/RA/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
