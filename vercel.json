{
  "version": 2,
  "outputDirectory": "Public",
  "cleanUrls": true,

  "rewrites": [
    {
      "source": "/",
      "destination": "/Login"
    },

    {
      "source": "/students",
      "destination": "/students/index.html"
    },

    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/Audit",
      "destination": "/admin/Audit.html"
    },
    {
      "source": "/admin/Hostels",
      "destination": "/admin/Hostels.html"
    },
    {
      "source": "/admin/Profile",
      "destination": "/admin/Profile.html"
    },
    {
      "source": "/admin/Report",
      "destination": "/admin/Report.html"
    },
    {
      "source": "/admin/Session",
      "destination": "/admin/Session.html"
    },
    {
      "source": "/admin/Staff",
      "destination": "/admin/Staff.html"
    },
    {
      "source": "/admin/Student",
      "destination": "/admin/Student.html"
    },

    {
      "source": "/RASD",
      "destination": "/RASD/rasd-index.html"
    },
    {
      "source": "/RASD/",
      "destination": "/RASD/rasd-index.html"
    },
    {
      "source": "/RASD/AuditLogs",
      "destination": "/RASD/AuditLogs.html"
    },
    {
      "source": "/RASD/management",
      "destination": "/RASD/management.html"
    },
    {
      "source": "/RASD/Profile",
      "destination": "/RASD/Profile.html"
    },
    {
      "source": "/RASD/Reports",
      "destination": "/RASD/Reports.html"
    },
    {
      "source": "/RASD/Session",
      "destination": "/RASD/Session.html"
    },

    {
      "source": "/HRA",
      "destination": "/HRA/hra-index.html"
    },
    {
      "source": "/HRA/",
      "destination": "/HRA/hra-index.html"
    },
    {
      "source": "/HRA/BedCheck",
      "destination": "/HRA/BedCheck.html"
    },
    {
      "source": "/HRA/MyHostel",
      "destination": "/HRA/MyHostel.html"
    },
    {
      "source": "/HRA/Profile",
      "destination": "/HRA/Profile.html"
    },

    {
      "source": "/RA",
      "destination": "/RA/ra-index.html"
    },
    {
      "source": "/RA/",
      "destination": "/RA/ra-index.html"
    },
    {
      "source": "/RA/BedCheck",
      "destination": "/RA/BedCheck.html"
    },
    {
      "source": "/RA/Profile",
      "destination": "/RA/Profile.html"
    },
    {
      "source": "/RA/student",
      "destination": "/RA/student.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}