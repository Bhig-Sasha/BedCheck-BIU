{
  "version": 2,
  "outputDirectory": "Public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/Login"
    },
    {
      "source": "/students",
      "destination": "/students/index.html"
    },
    {
      "source": "/students/",
      "destination": "/students/index.html"
    },
    {
      "source": "/students/(.*)",
      "destination": "/students/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/students/index.html",
      "destination": "/students",
      "permanent": true
    },
    {
      "source": "/admin/index.html",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}